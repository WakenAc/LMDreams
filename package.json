{
  "name": "lmdreams",
  "private": true,
  "version": "1.0.0",
  "description": "Website institucional da LMDreams, empresa de construção civil e remodelações.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts && tsx scripts/generate-seo.ts",
    "build:pages": "cross-env BASE_PATH=/LMDreams/ SITE_URL=https://wakenac.github.io/LMDreams npm run build",
    "build:root": "cross-env BASE_PATH=/ SITE_URL=https://www.exemplo.pt OUT_DIR=.tmp/dist-root npm run build && tsx scripts/check-links.ts --dir .tmp/dist-root --base /",
    "preview": "tsx scripts/serve-dist.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:seo": "tsx scripts/check-seo.ts",
    "check:forbidden": "tsx scripts/check-forbidden.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "check": "npm run typecheck && npm run lint && npm run build:pages && npm run check:links && npm run check:contrast && npm run check:placeholders && npm run check:seo && npm run check:forbidden && npm run check:budget && npm run build:root && npm run test:e2e",
    "deploy": "gh workflow run deploy.yml --ref main",
    "og:image": "tsx scripts/og-image.ts",
    "contact-sheet": "tsx scripts/contact-sheet.ts",
    "favicons": "tsx scripts/favicons.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "lighthouse": "^12.6.1",
    "node-html-parser": "^7.1.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-imagetools": "^12.0.1"
  }
}
